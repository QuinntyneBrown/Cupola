@startuml
title C13 copy to notebook with snapshot capture
' Traces: OMCT-C13-L2-02.01, OMCT-C13-L2-02.02
actor Operator
participant "SelectionService" as Selection
participant "CopyToNotebookAction" as Action
participant "NotebookStorageService" as StorageService
participant "NotebookSnapshotContainer" as Snapshot
participant "@cupola/core NotebookService" as NotebookService
participant "HttpObjectsGateway" as ObjectsGateway
participant "Cupola.Api ObjectsController" as ObjectsController
participant "Cupola.Core IObjectStore" as Store
participant "RealtimeHub" as Hub

Operator -> Action: run copy-to-notebook
activate Action
Action -> StorageService: getDefault()
activate StorageService
StorageService --> Action: default notebook destination
deactivate StorageService
Action -> Selection: get compatible selected content
activate Selection
Selection --> Action: selected object-view context
deactivate Selection
Action -> Snapshot: capture view representation
activate Snapshot
Snapshot --> Action: snapshot representation
deactivate Snapshot
Action -> NotebookService: createEntryWithContext(destination, context, snapshot)
activate NotebookService
NotebookService --> Action: notebook with captured entry
deactivate NotebookService
Action -> ObjectsGateway: saveNotebook(notebook)
activate ObjectsGateway
ObjectsGateway -> ObjectsController: update domain object
activate ObjectsController
ObjectsController -> Store: persist captured entry
activate Store
Store --> ObjectsController: persisted notebook
deactivate Store
ObjectsController -> Hub: emit objectChanged
activate Hub
Hub --> ObjectsController: broadcast accepted
deactivate Hub
ObjectsController --> ObjectsGateway: persisted notebook
deactivate ObjectsController
ObjectsGateway --> Action: persisted notebook
deactivate ObjectsGateway
Action --> Operator: show copy result
deactivate Action
@enduml
