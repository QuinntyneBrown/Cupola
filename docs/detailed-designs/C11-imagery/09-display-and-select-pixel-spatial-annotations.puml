@startuml
title Pixel-spatial annotation display and selection
' Traces: OMCT-C11-L2-03.02, OMCT-C11-L2-03.03
actor Operator
participant "Imagery View" as View
participant "Annotation Store" as Annotations
participant "Annotations Canvas" as Canvas
participant "Application Selection Service" as Selection

View -> Annotations: readForImage(timestamp)
activate Annotations
Annotations --> View: targeted annotations
deactivate Annotations
View -> Canvas: renderRectangles(normalizedCoordinates)
activate Canvas
Canvas --> View: annotation rectangles rendered
Operator -> Canvas: selectByClickOrMarquee(region)
Canvas -> Canvas: intersectAnnotations(region)
Canvas -> Selection: publish(intersectingAnnotations)
activate Selection
Selection --> Canvas: selection published
deactivate Selection
Canvas --> Operator: annotations selected
deactivate Canvas
@enduml
