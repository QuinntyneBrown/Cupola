@startuml
title C03 object duplication
' Traces: OMCT-C03-L2-02.02
actor Operator
participant "Duplicate Action" as Duplicate
participant "@cupola/core Object Service" as Objects
participant "Composition Service" as Composition
participant "@cupola/api HttpObjectsGateway" as Gateway
participant "Cupola.Api ObjectsController" as Controller
participant "IObjectStore" as Store

Operator -> Duplicate ++: invoke(source, destination, replacementName)
Duplicate -> Composition ++: allow(destination, source type)
Composition --> Duplicate --: eligible destination
Duplicate -> Objects ++: clone with new identifier
alt replacement name supplied
    Objects --> Duplicate --: distinct object with replacement name
else no replacement name
    Objects --> Duplicate --: distinct object preserving source name
end
Duplicate -> Gateway ++: POST /api/objects
Gateway -> Controller ++: POST /api/objects
Controller -> Store ++: create(duplicate object)
Store --> Controller --: duplicate created
Controller --> Gateway --: duplicate object
Gateway --> Duplicate --: duplicate object
Duplicate -> Composition ++: add(destination, duplicate identifier)
Composition --> Duplicate --: destination updated
Duplicate --> Operator --: duplication completed
@enduml
