@startuml
title C05 Clock and timer display objects
' Traces: OMCT-C05-L2-05.03, OMCT-C05-L2-05.04, OMCT-C05-L2-05.05

actor "Operator" as Operator
participant "cupola Shell" as Shell
participant "Timer Interceptor" as TimerInterceptor
participant "@cupola/components Clock Object View" as ClockView
participant "@cupola/components Timer Object View" as TimerView
participant "Timer Actions" as TimerActions

Shell -> TimerInterceptor: load(timer domain object)
activate TimerInterceptor
alt legacy timer properties exist
    TimerInterceptor -> TimerInterceptor: map legacy properties to configuration
    TimerInterceptor --> Shell: current timer configuration
else current configuration exists
    TimerInterceptor --> Shell: current timer configuration
end
deactivate TimerInterceptor

Shell -> ClockView: render(clock configuration)
activate ClockView
ClockView -> ClockView: apply timezone, hour mode, and display format
ClockView --> Shell: clock displayed
deactivate ClockView

Operator -> TimerActions: start, pause, stop, or restart
activate TimerActions
TimerActions -> TimerView: apply state change
activate TimerView
TimerView -> TimerView: calculate elapsed or remaining duration
TimerView --> TimerActions: updated timer display
deactivate TimerView
TimerActions --> Operator: timer state changed
deactivate TimerActions
@enduml
