      "conditions": [
        {
          "id": "stale",
          "name": "No data",
          "trigger": "all",
          "output": "NO DATA",
          "criteria": [
            { "id": "s1", "telemetryKeyString": "pwr.bus_v", "metadataKey": "value", "operation": "isOlderThan", "input": [1000] }
